---
import Nav from "../components/Nav.tsx";

interface Props {
  title?: string;
}

const {
  title = "Matías Sepúlveda — Software Engineer",
} = Astro.props;

---

<!doctype html>
<html lang="en" id="root" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Matías Sepúlveda is a software engineer focused on distributed systems, platform engineering, Go, TypeScript, GCP, Terraform, security, and applied AI." />
    <meta name="keywords" content="Software Engineer, Platform Engineering, Distributed Systems, Go, TypeScript, Next.js, GCP, Terraform, Event-Driven Architecture, Applied AI" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#171717" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href="https://malygod.netlify.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://malygod.netlify.app/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Distributed systems, platform engineering, and cloud-native delivery—from architecture to production." />
    <meta property="og:image" content="https://malygod.netlify.app/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Distributed systems, platform engineering, and cloud-native delivery—from architecture to production." />
    <meta name="twitter:image" content="https://malygod.netlify.app/og.png" />
    <title>{title}</title>
  </head>
  <body class="bg-stone-100 dark:bg-neutral-950">
    <div
      class="absolute max-w-full top-0 z-[-2] h-svh w-svw transition-colors duration-500 bg-[radial-gradient(ellipse_90%_80%_at_50%_-30%,rgba(0,0,0,0.5),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_70%_80%_at_50%_-20%,rgba(50,50,50,0.8),rgba(255,255,255,0))]"
    >
    </div>
    <Nav client:load/>
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, "Segoe UI";
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }
  body {
    margin: 0;
    overflow-x: hidden;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
  /* Estilo para Chrome, Safari y Opera */
  ::-webkit-scrollbar {
    scrollbar-width: thin; /* Ancho del scrollbar */
    scrollbar-color: white black; /* Color del pulgar y la pista del scrollbar */
    width: 5px; /* Ancho del scrollbar */
  }

  ::-webkit-scrollbar-track {
    background: #555; /* Color de la pista del scrollbar */
  }

  ::-webkit-scrollbar-thumb {
    background: #555; /* Color del pulgar del scrollbar */
    display: none;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #000000; /* Color del pulgar del scrollbar al pasar el mouse */
  }

  /* Estilo para Firefox */
  * {
    scrollbar-width: thin; /* Ancho del scrollbar */
    scrollbar-color: rgb(255, 255, 255) black; /* Color del pulgar y la pista del scrollbar */
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* animation slide up */

  @keyframes slide-up {
    0% {
      opacity: 0;
      transform: translate3d(0, 50%, 0);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0%, 0);
    }
  }

  .animate-slide-up {
    animation: slide-up 0.7s ease-out;
    opacity: 1;
  }

  /* animation left to right */

  @keyframes slide-right {
    0% {
      opacity: 0;
      transform: translate3d(50%, 0, 0);
    }
    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  .animate-slide-right {
    animation: slide-right 1s ease-out;
    opacity: 1;
  }
</style>
